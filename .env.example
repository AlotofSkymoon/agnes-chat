# ===========================================================================
# 存储后端
#
# STORAGE_BACKEND 决定用哪套：
#   auto      —— 默认。**有 Upstash 就全平台统一用 Upstash**（数据互通）
#                没配 Upstash 才退回平台原生存储
#   unified   —— ⭐ 全平台统一走 Upstash，账号/聊天/配置**全部共享**
#                （多平台部署时用它，比双写同步简单可靠得多）
#   cloudflare —— 强制 KV + D1
#   upstash   —— 强制 Upstash
#
# ⚠️ 选 unified 时下面两个 Upstash 变量必填，否则启动即报错。
# ===========================================================================
STORAGE_BACKEND=auto

# ---------------------------------------------------------------------------
# Upstash Redis（服务端专用，绝对不要加 NEXT_PUBLIC_ 前缀）
# 在 https://console.upstash.com/redis 创建数据库后，复制 REST URL / TOKEN
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# 会话签名密钥（任意随机长字符串即可）
# 生成方式：openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET=please-change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# 站点内置（预设）Agnes API Key —— 只存在服务端，永远不会下发到浏览器。
# 未登录 / 没填自己的 Key 的用户默认用它聊天；
# 只有 role=admin 的用户能在 /admin 里查看完整值。
# ---------------------------------------------------------------------------
PRESET_AGNES_API_KEY=sk-d5DyJCcfW9TmkeIHnfFPgHJ2ZjxfKHCx5ip3tR14abyrgZEi

# ---------------------------------------------------------------------------
# 联网搜索 API Key（可选）
#
# 一个都不填也能联网 —— 会自动用免费的 Bing RSS / Sogou / DuckDuckGo。
# 填了任一 Key 就优先用它（更稳定，爬虫源随时可能被反爬）。
#
# ⭐ 推荐 Serper：注册只要邮箱，不需要信用卡，免费 2500 次，走 Google 索引
#    https://serper.dev
# ---------------------------------------------------------------------------
SERPER_API_KEY=
# TAVILY_API_KEY=      # 专为 LLM 设计，返回已提炼的片段  https://tavily.com
# BRAVE_API_KEY=       # 独立索引，不依赖 Google/Bing     https://brave.com/search/api
# BOCHA_API_KEY=       # 国内可用，中文友好               https://open.bochaai.com
# EXA_API_KEY=         # 语义/神经搜索                    https://exa.ai

# 可选：覆盖默认上游地址（一般不用改）
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ===========================================================================
# 对象存储（图片 / 视频上传，可选）—— 按部署平台二选一
#   Cloudflare Workers → 只能用 Cloudflare R2（填 R2_*）
#   Vercel             → 只能用 Backblaze B2（填 B2_*）
# 配好后全站用户都能直接用，密钥不会下发到浏览器。
# 部署到 Cloudflare 时请用 `wrangler secret put`，不要写在这里提交到仓库。
# ===========================================================================

# --- Cloudflare R2（Workers 部署专用，零出站流量费 + 10GB 免费）---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agnes-chat
# 公开访问域名（r2.dev 或自定义域），留空则用 Endpoint 拼接
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# S3 兼容（任何支持 S3 API 的存储：R2 / B2 / MinIO / AWS S3 / 阿里云 OSS …）
#
# 只在「非 Workers binding」场景需要（Vercel / Netlify，或 Workers 上改用外部 S3）。
# 用 Cloudflare R2 binding 时上面这些都不用填。
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# 寻址风格。不填 = 按 endpoint 自动判断（推荐）：
#   R2 / MinIO / 内网 IP / localhost  → path-style
#   AWS S3 / B2 / 阿里云 OSS          → virtual-host
# 自动判断不对时显式覆盖：true = path-style，false = virtual-host
S3_FORCE_PATH_STYLE=

# ---------------------------------------------------------------------------
# 品牌与署名
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PROJECT_LINK=https://github.com/wcvjk8tnz8-create/agnes-chat
# NEXT_PUBLIC_BY_LINE=by https://github.com/wcvjk8tnz8-create/agnes-chat

# --- Backblaze B2（Vercel 部署专用，10GB 免费存储）---
# 注意：B2 的 S3 兼容层只覆盖部分操作
B2_REGION=us-west-004
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=
B2_PUBLIC_BASE_URL=

# --- Supabase Storage（1GB 免费存储 + 自带 CDN）---
# 只需下面 5 个，endpoint 和公开域名会自动拼
# 密钥在项目后台 Storage → S3 Configuration → Access keys 生成
SUPABASE_PROJECT_REF=       # 项目 ref，如 abcdefghijklmnop
SUPABASE_REGION=us-east-1   # 项目区域，从 S3 Configuration 页面复制
SUPABASE_BUCKET=agnes-chat
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=
# 公开访问域名，留空则自动拼：
# https://<ref>.supabase.co/storage/v1/object/public/<bucket>
SUPABASE_PUBLIC_BASE_URL=

# ===========================================================================
# 品牌与中转配置（演示站核心，改这里就能换成你自己的服务）
# ===========================================================================

# 站点显示名（标题栏、侧边栏、页脚）。默认 Agnes AI
NEXT_PUBLIC_SITE_NAME=Agnes AI
# 副标题，跟在站点名后面
NEXT_PUBLIC_SITE_TAGLINE=免费聊天
# SEO 描述，留空则自动拼接
# NEXT_PUBLIC_SITE_DESCRIPTION=

# 配色主题：fuwari（清透蓝，默认）| violet-rose（紫玫瑰）
# 访客可在「设置 → 配色主题」里随时切换，这里只决定首次打开用哪套
NEXT_PUBLIC_THEME=fuwari

# 上游项目 / 源码链接（页脚署名，LICENSE 要求保留）
NEXT_PUBLIC_AUTHOR_NAME=wcvjk8tnz8
NEXT_PUBLIC_UPSTREAM_URL=https://github.com/AlotofSkymoon/agnes-chat
NEXT_PUBLIC_REPO_URL=https://github.com/AlotofSkymoon/agnes-chat

# ---- 中转服务（不填就用 Agnes 默认）----
# 站长提供的 Key，访客不填时用这个（服务端专用，不下发浏览器）
# PRESET_AGNES_API_KEY=sk-your-relay-key
# 中转地址，兼容 OpenAI /chat/completions 即可（One API / New API / VoAPI 都行）
# UPSTREAM_BASE_URL=https://apihub.agnes-ai.com/v1
# 默认模型
# UPSTREAM_MODEL=agnes-3.0-flash

# ---- 演示站权限开关 ----
# 设 false 锁死：访客只能用站长内置的 Key，看不到也改不了配置
# NEXT_PUBLIC_ALLOW_CUSTOM_KEY=false

# 是否必须登录才能对话（默认 false = 免登录可用）
# 设 true 后，访客必须先注册/登录才能发消息
# NEXT_PUBLIC_REQUIRE_LOGIN=true

# D1 初始化接口的签名密钥（界面部署时用于生成建表令牌）
# JWT_SECRET=<openssl rand -base64 32>
# 设 false 锁死 Base URL
# NEXT_PUBLIC_ALLOW_CUSTOM_BASE_URL=false

# ---- 隐私：默认不暴露源码链接 ----
# 默认 false —— 页脚与赞助页不显示 GitHub 仓库地址，避免暴露账号与部署来源。
# 想开源宣传就改成 true。
# NEXT_PUBLIC_SHOW_SOURCE_LINKS=false
# NEXT_PUBLIC_BY_LINE="by wcvjk8tnz8"
