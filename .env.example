# ===========================================================================
# 存储后端二选一：
#   1) 部署到 Cloudflare Workers → 用 KV + D1，下面这两行【留空】即可
#   2) 部署到 Vercel / 本地开发   → 填 Upstash Redis
# 有 KV/D1 绑定时自动优先走 Cloudflare，否则走 Upstash。
# ===========================================================================

# ---------------------------------------------------------------------------
# Upstash Redis（服务端专用，绝对不要加 NEXT_PUBLIC_ 前缀）
# 在 https://console.upstash.com/redis 创建数据库后，复制 REST URL / TOKEN
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# 会话签名密钥（任意随机长字符串即可）
# 生成方式：openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET=please-change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# 站点内置（预设）Agnes API Key —— 只存在服务端，永远不会下发到浏览器。
# 未登录 / 没填自己的 Key 的用户默认用它聊天；
# 只有 role=admin 的用户能在 /admin 里查看完整值。
# ---------------------------------------------------------------------------
PRESET_AGNES_API_KEY=sk-d5DyJCcfW9TmkeIHnfFPgHJ2ZjxfKHCx5ip3tR14abyrgZEi

# 可选：覆盖默认上游地址（一般不用改）
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ===========================================================================
# 对象存储（图片 / 视频上传，可选）—— 按部署平台二选一
#   Cloudflare Workers → 只能用 Cloudflare R2（填 R2_*）
#   Vercel             → 只能用 Backblaze B2（填 B2_*）
# 配好后全站用户都能直接用，密钥不会下发到浏览器。
# 部署到 Cloudflare 时请用 `wrangler secret put`，不要写在这里提交到仓库。
# ===========================================================================

# --- Cloudflare R2（Workers 部署专用，零出站流量费 + 10GB 免费）---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agnes-chat
# 公开访问域名（r2.dev 或自定义域），留空则用 Endpoint 拼接
R2_PUBLIC_BASE_URL=

# --- Backblaze B2（Vercel 部署专用，10GB 免费存储）---
# 注意：B2 的 S3 兼容层只覆盖部分操作
B2_REGION=us-west-004
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=
B2_PUBLIC_BASE_URL=

# ===========================================================================
# 品牌与中转配置（演示站核心，改这里就能换成你自己的服务）
# ===========================================================================

# 站点显示名（标题栏、侧边栏、页脚）。默认 Agnes AI
NEXT_PUBLIC_SITE_NAME=Agnes AI
# 副标题，跟在站点名后面
NEXT_PUBLIC_SITE_TAGLINE=免费聊天
# SEO 描述，留空则自动拼接
# NEXT_PUBLIC_SITE_DESCRIPTION=

# 配色主题：fuwari（清透蓝，默认）| violet-rose（紫玫瑰）
# 访客可在「设置 → 配色主题」里随时切换，这里只决定首次打开用哪套
NEXT_PUBLIC_THEME=fuwari

# 上游项目 / 源码链接（页脚署名，LICENSE 要求保留）
NEXT_PUBLIC_AUTHOR_NAME=wcvjk8tnz8
NEXT_PUBLIC_UPSTREAM_URL=https://github.com/AlotofSkymoon/agnes-chat
NEXT_PUBLIC_REPO_URL=https://github.com/AlotofSkymoon/agnes-chat

# ---- 中转服务（不填就用 Agnes 默认）----
# 站长提供的 Key，访客不填时用这个（服务端专用，不下发浏览器）
# PRESET_AGNES_API_KEY=sk-your-relay-key
# 中转地址，兼容 OpenAI /chat/completions 即可（One API / New API / VoAPI 都行）
# UPSTREAM_BASE_URL=https://apihub.agnes-ai.com/v1
# 默认模型
# UPSTREAM_MODEL=agnes-3.0-flash

# ---- 演示站权限开关 ----
# 设 false 锁死：访客只能用站长内置的 Key，看不到也改不了配置
# NEXT_PUBLIC_ALLOW_CUSTOM_KEY=false

# 是否必须登录才能对话（默认 false = 免登录可用）
# 设 true 后，访客必须先注册/登录才能发消息
# NEXT_PUBLIC_REQUIRE_LOGIN=true
# 设 false 锁死 Base URL
# NEXT_PUBLIC_ALLOW_CUSTOM_BASE_URL=false
