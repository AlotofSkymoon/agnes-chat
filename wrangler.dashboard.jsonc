{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agnes-chat",
  // OpenNext 构建产物入口，不要手改
  "main": ".open-next/worker.js",
  // 兼容日期：必须是「今天或更早」，不能是未来日期（否则报尚未发布）。
  // 也不要设得太旧——Next.js 14 依赖较新的 nodejs_compat 行为。
  // 这里取当月初，既已发布又足够新。
  "compatibility_date": "2026-09-01",
  // Next.js 需要 Node 兼容层
  "compatibility_flags": ["nodejs_compat"],

  // 静态资源（Next.js 的 _next/static 等）
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // ---------- Cloudflare 三件套 ----------
  // 占位符 __KV_ID__ / __D1_ID__ 会由 GitHub Actions 用 Secrets 自动替换，
  // 手动部署时把这里改成你自己的 ID 即可。
  // ---------- 界面部署：绑定在 Cloudflare 后台点，不写在这里 ----------
  // 这两个项目（KV / D1 / R2）的 ID **不要手抄进配置文件** ——
  // 去 Dashboard → Workers → 你的项目 → 设置 → 绑定 → 添加，
  // 直接选已有的命名空间/数据库/桶即可，变量名必须是 KV / DB / R2
  //（小写 kv / db / r2 也能识别）。
  //
  // 这样省去复制 32 位十六进制串的麻烦，也避免填错 ID 导致
  //「部署成功但数据存不进去」这种极难排查的问题。
  //
  // "kv_namespaces": [{ "binding": "kv", "id": "" }],
  // "d1_databases": [
  //   { "binding": "db", "database_name": "agnes-chat-db", "database_id": "" }
  // ],

  // ---------------------------------------------------------------------------
  // R2 对象存储（图片 / 视频等文件）
  //
  // ⚠️ 部署前必须先建桶，否则 wrangler deploy 会报 "bucket not found"：
  //      npx wrangler r2 bucket create agnes-chat
  //
  // 上传走「预签名直传」：浏览器从 /api/upload/presign 拿到签名链接后
  // 直接 PUT 到 R2，文件不经过 Worker —— 所以能传大文件，
  // 不受 Workers 请求体大小限制。
  // 这个 binding 供服务端直接读写（删除、列举、生成临时链接）使用。
  // ---------------------------------------------------------------------------
  // "r2_buckets": [{ "binding": "r2", "bucket_name": "agnes-chat" }],

  // 非敏感配置。
  // 敏感值（PRESET_AGNES_API_KEY / SESSION_SECRET）请在
  // Dashboard → 设置 → 变量和机密 里添加，类型选「机密」。
  "vars": {
    "NEXT_PUBLIC_SITE_NAME": "Agnes AI",
    // 界面部署没有 Actions 脚本帮忙盖章，这三个声明预置在这里：
    // CF_PLATFORM 让运行时知道自己在 Cloudflare（否则误判成 local）；
    // CF_R2_BOUND 声明已绑定 R2（binding 对象运行时未必探得到）；
    // 桶名若不是 agnes-chat，改下面 R2_BUCKET_NAME 的值。
    "CF_PLATFORM": "cloudflare",
    "CF_R2_BOUND": "1",
    "R2_BUCKET_NAME": "agnes-chat"
  },

  "observability": {
    "enabled": true
  }
}
