{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agnes-chat",
  // OpenNext 构建产物入口，不要手改
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-12",
  // Next.js 需要 Node 兼容层
  "compatibility_flags": ["nodejs_compat"],

  // 静态资源（Next.js 的 _next/static 等）
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // ---------- Cloudflare 三件套 ----------
  // 占位符 __KV_ID__ / __D1_ID__ 会由 GitHub Actions 用 Secrets 自动替换，
  // 手动部署时把这里改成你自己的 ID 即可。
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "__KV_ID__"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agnes-chat-db",
      "database_id": "__D1_ID__"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "agnes-chat",
      // 对象直传用的是预签名 URL，凭证走服务端环境变量，不用这个 binding 读写
      "preview_bucket_name": "agnes-chat-preview"
    }
  ],

  // 非敏感配置；密钥一律用 wrangler secret put（见部署教程）
  "vars": {
    "NEXT_PUBLIC_SITE_NAME": "Agnes AI 免费聊天"
  },

  "observability": {
    "enabled": true
  }
}
